      "x": 0,
      "y": 0,
      "w": 6,
      "h": 4,
      "kind": "Gauge",
      "name": "CPU Usage - Average",
      "properties": {
        "shape": "chronograf-v2",
        "queries": [
          {
            "text": "from(bucket: \"rpi-cluster\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"cpu\")\n  |> filter(fn: (r) => r[\"_field\"] == \"usage_user\")\n  |> mean()",
            "editMode": "advanced",
