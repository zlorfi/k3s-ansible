# MikroTik RouterOS API Configuration
# Copy this file to .env and fill in your actual values

# MikroTik RouterOS device IP address or hostname
# Default: 192.168.1.1
MIKROTIK_HOST=192.168.1.1

# API username
# Default: admin
# IMPORTANT: Create a dedicated user for API access for security
MIKROTIK_USER=admin

# API password (REQUIRED)
# Create a strong, unique password
# NEVER commit this file with real credentials to version control
MIKROTIK_PASSWORD=your_secure_password_here

# Connection timeout in seconds
# Default: 10
# Increase this if you experience timeout issues with slow networks
MIKROTIK_TIMEOUT=10

# API port number
# Default: 8728 (RouterOS API port)
# Some RouterOS instances use: 8729 (API-SSL), 13 (legacy)
# Most modern RouterOS uses 8728 for unencrypted API
MIKROTIK_PORT=8728

# Logging level (Optional)
# Options: trace, debug, info, warn, error
# Default: info
# Use 'debug' or 'trace' for troubleshooting
# RUST_LOG=debug

# Example configurations for different scenarios:

# --- Development Machine ---
# MIKROTIK_HOST=192.168.1.1
# MIKROTIK_PORT=8728
# MIKROTIK_USER=admin
# MIKROTIK_PASSWORD=dev_password
# RUST_LOG=debug

# --- Production Machine ---
# MIKROTIK_HOST=192.168.1.1
# MIKROTIK_PORT=8728
# MIKROTIK_USER=poe-controller
# MIKROTIK_PASSWORD=prod_secure_password
# MIKROTIK_TIMEOUT=10
# RUST_LOG=info

# --- Docker/Container ---
# MIKROTIK_HOST=mikrotik.internal
# MIKROTIK_PORT=8728
# MIKROTIK_USER=api-user
# MIKROTIK_PASSWORD=container_password
# MIKROTIK_TIMEOUT=15

# --- Kubernetes ---
# MIKROTIK_HOST=192.168.1.1
# MIKROTIK_PORT=8728
# MIKROTIK_USER=k8s-controller
# MIKROTIK_PASSWORD=k8s_password
# MIKROTIK_TIMEOUT=20

# SECURITY NOTES:
# 1. Never commit .env files with real credentials to git
# 2. Add .env to .gitignore (already done in this project)
# 3. Use strong, unique passwords
# 4. Create dedicated API users with minimal permissions on RouterOS
# 5. Restrict API access via RouterOS firewall rules
# 6. Rotate passwords periodically
